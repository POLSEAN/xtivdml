Package: xtivdml
Type: Package
Title: Double Machine Learning for Static Panel Models with Fixed Effects and Endogenous Treatment
Version: 0.1.3
Date: 2026-03-20
Authors@R: c(
  person("Annalivia", "Polselli", role = c("aut", "cre"),
         email = "apolselli.econ@gmail.com",
